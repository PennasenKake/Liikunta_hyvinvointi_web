# .env.example: ympäristömuuttujien malli. Kopioi tiedostoksi .env.local tarvittaessa.
# Vite päästää selaimeen vain VITE_-alkuiset muuttujat: älä koskaan laita salaisuuksia niihin.

# Sivuston julkinen osoite (canonical, sitemap, jakokuva, rakennetieto). Oletus: https://tahkonamanda.fi
# VITE_SITE_URL=https://tahkonamanda.fi

# 1 = esikatselu: noindex-tagi ja robots.txt kieltää indeksoinnin
# VITE_NOINDEX=1
