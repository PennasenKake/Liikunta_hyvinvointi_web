# .env.example: ympäristömuuttujien mallipohja.
#
# Käyttö: kopioi tämä tiedosto nimelle .env.local ja täytä arvot.
#   PowerShell:  Copy-Item .env.example .env.local
#   macOS/Linux: cp .env.example .env.local
#
# .env.local EI mene versionhallintaan (web/.gitignore estää sen).
# Tämä tiedosto saa olla repossa, koska siinä on vain muuttujien nimet, ei oikeita arvoja.
#
# TILA: sivusto toimii toistaiseksi ilman näitä. Muuttujat otetaan käyttöön vaiheittain:
# Google-kalenteri (vaihe 7), julkaisu (vaihe 10) ja Sanity (vaihe 11).
#
# HUOM: NEXT_PUBLIC_-alkuiset muuttujat näkyvät selaimessa.
# Salaisuudet (API-avaimet, tokenit) eivät koskaan saa alkaa NEXT_PUBLIC_.

# --- Sivusto ---------------------------------------------------------------
# Sivuston julkinen osoite. Käytetään metatiedoissa, sitemapissa ja jakolinkeissä.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google-kalenteri (vaihe 7) -----------------------------------------------
# API-avain Google Cloud Consolesta, rajattuna vain Google Calendar API:in.
# Salaisuus: käytetään vain palvelimella (lib/calendar.ts).
GOOGLE_API_KEY=
# Julkisen kalenterin tunniste, esim. xxxxxxxx@group.calendar.google.com
GOOGLE_CALENDAR_ID=

# --- Sanity-sisällönhallinta (vaihe 11) ---------------------------------------------
# Projektin tunniste ja datasetti ovat julkisia tietoja.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Salaisuus: tarkistaa, että sivun päivityspyyntö tulee oikeasti Sanitysta.
SANITY_REVALIDATE_SECRET=
